{
  "name": "agents-in-production",
  "private": true,
  "type": "module",
  "workspaces": [
    "testbed",
    "01-run-state-and-durability"
  ],
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "db:up": "docker compose -f testbed/docker-compose.yml up -d --wait",
